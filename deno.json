{
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-sys src/main.ts",
    "dev": "deno run --watch --allow-read --allow-write --allow-ffi --allow-env --allow-sys src/main.ts",
    "check": "deno check src/main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "compile": "deno compile --allow-read --allow-write --allow-ffi --allow-env --allow-sys --include src/mouseMovement.ts --output dist/afk-bot src/main.ts"
  },
  "imports": {
    "@nut-tree-fork/nut-js": "npm:@nut-tree-fork/nut-js@^4.2.6",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.6.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.worker", "esnext"]
  },
  "fmt": {
    "lineWidth": 90,
    "indentWidth": 2,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
